# Copier vers .env.enterprise ; ne jamais publier les vrais secrets.
APP_API_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
# Le mot de passe URL doit correspondre a POSTGRES_PASSWORD ; encoder les caracteres reserves.
DATABASE_URL=postgresql+psycopg://afridoc:REPLACE_WITH_DB_PASSWORD@db:5432/afridoc
# Aucune transmission documentaire a un fournisseur externe.
LLM_PROVIDER=off
# Pour un LLM prive, utiliser LLM_PROVIDER=local et docker compose --profile local-llm.
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_API_KEY=
GROQ_API_KEY=
ENABLE_LLM_TOOL_ROUTER=false
ENABLE_SEMANTIC_EMBEDDINGS=false
